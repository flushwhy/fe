<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>fe</id>
    <version>__VERSION__</version>
    <title>Fe CLI</title>
    <authors>flushwhy</authors>
    <owners>flushwhy</owners>
    <licenseUrl>https://github.com/flushwhy/fe/blob/master/LICENSE</licenseUrl>
